# CodePicker Environment Variables Example
# Copy this file to '.env' and fill in your details.

# 1. API Keys (Essential)
# OpenRouter API key is required to use the LLM-dependent commands (run, fix, improve, agent)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. LLM Configuration (Optional Overrides)
# Overrides default model. Default is typically "google/gemini-2.5-pro" or "anthropic/claude-3-sonnet"
CODEPICKER_LLM_MODEL=anthropic/claude-3.5-sonnet

# Maximum budget cap in dollars for the current session/month
CODEPICKER_LLM_BUDGET=5.00

# Timeout in seconds for LLM API requests
CODEPICKER_LLM_TIMEOUT=60

# 3. Agent Execution Limits (Optional)
# Maximum number of steps/turns the agent can take per task execution
CODEPICKER_AGENT_MAX_TURNS=15

# 4. Environment Settings
# Set to 'production' to enforce strict safe defaults and budget blocks
CODEPICKER_ENV=production
