	if defaultValue != "" {
		fmt.Printf("%s [%s]: ", question, defaultValue)
	} else {
		fmt.Printf("%s: ", question)
	}

	if !c.scanner.Scan() {
		return defaultValue
	}
	input := strings.TrimSpace(c.scanner.Text())
	if input == "" {
