func NewRunner(q *Queue, s *database.Store, log logger.Logger, workers int, srcDir string) *Runner {
	if workers < 1 {
		workers = 1
	}
	return &Runner{
		Queue:       q,
		Store:       s,
		Logger:      log,
		Concurrency: workers,
		SrcDir:      srcDir,
	}
