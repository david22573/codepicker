			fmt.Println("\n" + strings.Repeat("-", 40))
			fmt.Printf("💰 Session Cost Summary:\n")
			fmt.Printf("   Requests: %d\n", count)
			fmt.Printf("   Total:    $%.4f\n", cost)
			fmt.Println(strings.Repeat("-", 40))
